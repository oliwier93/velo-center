<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeloCenter.App.ViewModels"
             x:Class="VeloCenter.App.Views.WorkoutsView"
             x:DataType="vm:WorkoutsViewModel">
    <UserControl.Styles>
        <Style Selector="Button.pagination-button">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.pagination-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource PanelHighlightBrush}" />
        </Style>

        <Style Selector="Button.pagination-button:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto"
          RowSpacing="12"
          VerticalAlignment="Stretch">
        <Border Padding="16"
                CornerRadius="18"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelStrokeBrush}"
                BorderThickness="1"
                VerticalAlignment="Top"
                IsVisible="{Binding HasNoActivities}">
            <StackPanel Spacing="6">
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding EmptyLibraryTitle}" />
                <TextBlock FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{Binding EmptyLibraryDescription}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="0"
                Padding="14"
                CornerRadius="22"
                Background="#0CFFFFFF"
                BorderBrush="{DynamicResource PanelStrokeBrush}"
                BorderThickness="1"
                IsVisible="{Binding HasActivities}">
            <ScrollViewer VerticalAlignment="Stretch"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding RideLibrary}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentRideViewModel">
                            <Border Margin="0,0,0,10"
                                    Padding="14"
                                    CornerRadius="18"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelStrokeBrush}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding Title}" />
                                        <TextBlock FontSize="13"
                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                   Text="{Binding StartDateLabel}" />
                                    </StackPanel>

                                    <StackPanel HorizontalAlignment="Right"
                                                Spacing="3">
                                        <TextBlock FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding DistanceLabel}" />
                                        <TextBlock FontSize="13"
                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding DurationLabel}" />
                                        <TextBlock FontSize="13"
                                                   Foreground="{DynamicResource AccentRoseBrush}"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding SourceLabel}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="16"
              Margin="0,0,0,4"
              IsVisible="{Binding HasPagination}">
            <Button Classes="pagination-button"
                    Command="{Binding PreviousPageCommand}"
                    Content="Poprzednia" />

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSubtleBrush}"
                       Text="{Binding PaginationLabel}" />

            <Button Grid.Column="2"
                    Classes="pagination-button"
                    Command="{Binding NextPageCommand}"
                    Content="Nastepna" />
        </Grid>
    </Grid>
</UserControl>
