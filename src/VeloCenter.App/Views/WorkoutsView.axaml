<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeloCenter.App.ViewModels"
             x:Class="VeloCenter.App.Views.WorkoutsView"
             x:DataType="vm:WorkoutsViewModel">
    <UserControl.Styles>
        <Style Selector="Button.pagination-button">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.pagination-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource PanelHighlightBrush}" />
        </Style>

        <Style Selector="Button.pagination-button:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="24">
        <ItemsControl ItemsSource="{Binding Highlights}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"
                               ItemWidth="240" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MetricTileViewModel">
                    <Border Width="240"
                            Margin="0,0,16,16"
                            Padding="18"
                            CornerRadius="22"
                            Background="{DynamicResource PanelStrongBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelStrokeBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="13"
                                       Foreground="{DynamicResource TextSubtleBrush}"
                                       Text="{Binding Label}" />
                            <TextBlock FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Value}" />
                            <TextBlock FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding Detail}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Padding="22"
                CornerRadius="24"
                Background="{DynamicResource PanelStrongBackgroundBrush}"
                BorderBrush="{DynamicResource PanelStrokeBrush}"
                BorderThickness="1">
            <StackPanel Spacing="16">
                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="Biblioteka aktywnosci" />

                <Border Padding="18"
                        CornerRadius="18"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelStrokeBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding HasNoActivities}">
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding EmptyLibraryTitle}" />
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding EmptyLibraryDescription}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ScrollViewer MaxHeight="660"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding HasActivities}">
                    <StackPanel Spacing="4">
                        <ItemsControl ItemsSource="{Binding RideLibrary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentRideViewModel">
                                    <Border Margin="0,0,0,12"
                                            Padding="16"
                                            CornerRadius="18"
                                            Background="{DynamicResource PanelBackgroundBrush}"
                                            BorderBrush="{DynamicResource PanelStrokeBrush}"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="16">
                                            <StackPanel Spacing="4">
                                                <TextBlock FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding Title}" />
                                                <TextBlock FontSize="13"
                                                           Foreground="{DynamicResource TextSubtleBrush}"
                                                           Text="{Binding StartDateLabel}" />
                                            </StackPanel>

                                            <StackPanel HorizontalAlignment="Right"
                                                        Spacing="4">
                                                <TextBlock FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding DistanceLabel}" />
                                                <TextBlock FontSize="13"
                                                           Foreground="{DynamicResource TextSubtleBrush}"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding DurationLabel}" />
                                                <TextBlock FontSize="13"
                                                           Foreground="{DynamicResource AccentRoseBrush}"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding SourceLabel}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="16"
                              Margin="0,4,0,8"
                              IsVisible="{Binding HasPagination}">
                            <Button Classes="pagination-button"
                                    Command="{Binding PreviousPageCommand}"
                                    Content="Poprzednia" />

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSubtleBrush}"
                                       Text="{Binding PaginationLabel}" />

                            <Button Grid.Column="2"
                                    Classes="pagination-button"
                                    Command="{Binding NextPageCommand}"
                                    Content="Nastepna" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
