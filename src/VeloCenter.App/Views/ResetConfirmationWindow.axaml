<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VeloCenter.App.Views.ResetConfirmationWindow"
        Width="484"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Button.dialog-action">
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.dialog-secondary">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
        </Style>

        <Style Selector="Button.dialog-secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource PanelHighlightBrush}" />
        </Style>

        <Style Selector="Button.dialog-secondary:pressed">
            <Setter Property="Background" Value="#2F182E" />
        </Style>

        <Style Selector="Button.dialog-secondary:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentRoseBrush}" />
        </Style>

        <Style Selector="Button.dialog-danger">
            <Setter Property="Background" Value="#6B1F2E" />
            <Setter Property="BorderBrush" Value="#A8455B" />
        </Style>

        <Style Selector="Button.dialog-danger:pointerover">
            <Setter Property="Background" Value="#7B2737" />
            <Setter Property="BorderBrush" Value="#C05C75" />
        </Style>

        <Style Selector="Button.dialog-danger:pressed">
            <Setter Property="Background" Value="#5B1826" />
        </Style>

        <Style Selector="Button.dialog-danger:focus-visible">
            <Setter Property="BorderBrush" Value="#F2A1B8" />
        </Style>
    </Window.Styles>

    <Border Margin="14"
            Padding="24"
            CornerRadius="28"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource ChromeBorderBrush}"
            BorderThickness="1"
            BoxShadow="0 18 48 0 #66000000">
        <Border Padding="22"
                CornerRadius="22"
                Background="{DynamicResource PanelStrongBackgroundBrush}"
                BorderBrush="{DynamicResource PanelStrokeBrush}"
                BorderThickness="1">
            <StackPanel Spacing="18">
                <Border Width="52"
                        Height="52"
                        CornerRadius="18"
                        Background="#6B1F2E"
                        BorderBrush="#A8455B"
                        BorderThickness="1">
                    <Path Width="24"
                          Height="24"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M12,3 A9,9 0 1 1 3,12 A9,9 0 0 1 12,3 M12,7 V12 M12,16.2 A1.15,1.15 0 1 0 12.1,16.2"
                          Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeLineCap="Round"
                          StrokeThickness="1.9" />
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Wyczysc wszystko?" />
                    <TextBlock FontSize="14"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="Tej operacji nie da sie cofnac. Usuniete zostana lokalna baza SQLite, konfiguracje integracji, sesje Stravy i zapisany stan aplikacji."
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="14"
                        CornerRadius="18"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelStrokeBrush}"
                        BorderThickness="1">
                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="Jesli chcesz zaczac od zera, potwierdz czyszczenie. W przeciwnym razie anuluj i nic nie zostanie zmienione."
                               TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="10">
                    <Button Classes="dialog-action dialog-secondary"
                            Click="CancelClick"
                            Content="Anuluj" />
                    <Button Classes="dialog-action dialog-danger"
                            Click="ConfirmClick"
                            Content="Wyczysc wszystko" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>
