<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeloCenter.App.ViewModels"
             x:Class="VeloCenter.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Border MaxWidth="640"
            Padding="24"
            CornerRadius="24"
            Background="{DynamicResource PanelStrongBackgroundBrush}"
            BorderBrush="{DynamicResource PanelStrokeBrush}"
            BorderThickness="1">
        <StackPanel Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="Wyczysc aplikacje" />
                <TextBlock FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Usuwa cala lokalna baze SQLite, konfiguracje integracji, sesje Stravy oraz bieżące preferencje aplikacji."
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="16"
                    CornerRadius="18"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelStrokeBrush}"
                    BorderThickness="1">
                <TextBlock FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="To reset nieodwracalny. Po wykonaniu aplikacja wraca do pustego stanu startowego."
                           TextWrapping="Wrap" />
            </Border>

            <Button Click="ResetApplicationClick"
                    HorizontalAlignment="Left">
                <Border Padding="18,14"
                        CornerRadius="20"
                        Background="#6B1F2E"
                        BorderBrush="#A8455B"
                        BorderThickness="1">
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Wyczysc wszystko" />
                </Border>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
