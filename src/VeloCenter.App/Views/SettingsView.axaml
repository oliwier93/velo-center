<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeloCenter.App.ViewModels"
             x:Class="VeloCenter.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Styles>
        <Style Selector="Button.reset-action">
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="#6B1F2E" />
            <Setter Property="BorderBrush" Value="#A8455B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.reset-action:pointerover">
            <Setter Property="Background" Value="#7B2737" />
            <Setter Property="BorderBrush" Value="#C05C75" />
        </Style>

        <Style Selector="Button.reset-action:pressed">
            <Setter Property="Background" Value="#5B1826" />
        </Style>

        <Style Selector="Button.reset-action:focus-visible">
            <Setter Property="BorderBrush" Value="#F2A1B8" />
        </Style>
    </UserControl.Styles>

    <Border MaxWidth="640"
            Padding="24"
            CornerRadius="24"
            Background="{DynamicResource PanelStrongBackgroundBrush}"
            BorderBrush="{DynamicResource PanelStrokeBrush}"
            BorderThickness="1">
        <StackPanel Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="Wyczysc aplikacje" />
                <TextBlock FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Usuwa cala lokalna baze SQLite, konfiguracje integracji, sesje Stravy oraz bieżące preferencje aplikacji."
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="16"
                    CornerRadius="18"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelStrokeBrush}"
                    BorderThickness="1">
                <TextBlock FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="To reset nieodwracalny. Po wykonaniu aplikacja wraca do pustego stanu startowego."
                           TextWrapping="Wrap" />
            </Border>

            <Button Classes="reset-action"
                    Click="ResetApplicationClick"
                    HorizontalAlignment="Left"
                    Content="Wyczysc wszystko" />
        </StackPanel>
    </Border>
</UserControl>
