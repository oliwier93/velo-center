<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VeloCenter.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="VeloCenter.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        d:DesignWidth="1680"
        d:DesignHeight="1080"
        Width="1680"
        Height="1080"
        MinWidth="1280"
        MinHeight="1080"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="/Assets/avalonia-logo.ico"
        Title="Velo Center">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.nav-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="#241A2036" />
            <Setter Property="Foreground" Value="{DynamicResource AccentRoseBrush}" />
        </Style>

        <Style Selector="Button.nav-item.selected">
            <Setter Property="Background" Value="#2A23153A" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.toolbar-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style Selector="Button.toolbar-button:pointerover">
            <Setter Property="Background" Value="#121A2036" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="ComboBox.range-selector">
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        </Style>
    </Window.Styles>

    <Grid ClipToBounds="False">
        <Border Width="{Binding SidebarWidth}"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource ChromeBorderBrush}"
                BorderThickness="0,0,1,0"
                ZIndex="10"
                PointerEntered="SidebarPointerEntered"
                PointerExited="SidebarPointerExited">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width"
                                      Duration="0:0:0.18" />
                </Transitions>
            </Border.Transitions>

            <Grid RowDefinitions="Auto,*">
                <Grid Margin="0,20,0,18">
                    <Grid Height="52"
                          ClipToBounds="True">
                        <Grid ColumnDefinitions="80,*">
                            <Border Width="52"
                                    Height="52"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="18"
                                    Background="#4FA669FF">
                                <Viewbox Width="30"
                                         Height="24"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Path Data="M5,17 A3.5,3.5 0 1 0 5.1,17 M19,17 A3.5,3.5 0 1 0 19.1,17 M8.5,17 L12.5,10 L16.5,17 M10.2,17 H14.7 M12.5,10 H17 M12.5,10 L10,6.5 H8"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource TextPrimaryBrush}"
                                          StrokeLineCap="Round"
                                          StrokeThickness="1.9" />
                                </Viewbox>
                            </Border>

                            <Border Grid.Column="1"
                                    ClipToBounds="True"
                                    IsVisible="{Binding IsSidebarContentExpanded}">
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding AppTitle}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <ItemsControl Grid.Row="1"
                              Margin="0,8,0,0"
                              ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItemViewModel">
                            <Button Classes="nav-item"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding ActivateCommand}"
                                    CommandParameter="{Binding .}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch">
                                <Border Background="{Binding $parent[Button].Background}">
                                    <Grid Height="60"
                                          ColumnDefinitions="4,*">
                                        <Border Width="4"
                                                Height="32"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AccentRoseBrush}"
                                                CornerRadius="99"
                                                Opacity="{Binding SelectionOpacity}" />

                                        <Grid Grid.Column="1"
                                              Margin="14,0,18,0"
                                              VerticalAlignment="Center">
                                            <Grid ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="14"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding IsExpanded}">
                                                <Border Width="42"
                                                        Height="42"
                                                        CornerRadius="15"
                                                        Background="{Binding IconBackground}">
                                                        <Path Width="20"
                                                              Height="20"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Data="{Binding IconPathData}"
                                                              Stroke="{Binding $parent[Button].Foreground}"
                                                              StrokeLineCap="Round"
                                                              StrokeThickness="1.9" />
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding $parent[Button].Foreground}"
                                                           Text="{Binding Title}" />
                                            </Grid>

                                            <Border Width="42"
                                                    Height="42"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding IconBackground}"
                                                    CornerRadius="15"
                                                    IsVisible="{Binding IsCollapsed}">
                                                <Path Width="20"
                                                      Height="20"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="{Binding IconPathData}"
                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                      StrokeLineCap="Round"
                                                      StrokeThickness="1.9" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Grid RowDefinitions="Auto,*,Auto">
            <Border Background="{DynamicResource TopBarBackgroundBrush}"
                    BorderBrush="{DynamicResource ChromeBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="108,18,28,18"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding CurrentSectionTitle}" />
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding CurrentSectionDescription}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <ComboBox x:Name="RangeSelectorComboBox"
                                  Classes="range-selector"
                                  ItemsSource="{Binding RangeOptions}"
                                  SelectedItem="{Binding SelectedRangeOption}"
                                  SelectionChanged="RangeSelectorSelectionChanged"
                                  IsVisible="{Binding ShowTopBarRangeSelector}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActivityRangeOptionViewModel">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Classes="toolbar-button"
                                Command="{Binding SyncCommand}"
                                ToolTip.Tip="Synchronizuj polaczone integracje">
                            <Border Width="44"
                                    Height="44"
                                    CornerRadius="16"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentStrongBrush}"
                                    BorderThickness="1">
                                <Viewbox Width="18"
                                         Height="18"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Path Data="M20,12 A8,8 0 0 1 8.7,19.3 M20,12 L17.1,9.1 M20,12 L16.2,15.1 M4,12 A8,8 0 0 1 15.3,4.7 M4,12 L6.9,8.9 M4,12 L7.8,15.1"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource TextPrimaryBrush}"
                                          StrokeLineCap="Round"
                                          StrokeThickness="1.9" />
                                </Viewbox>
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Canvas IsHitTestVisible="False">
                    <Border Width="320"
                            Height="320"
                            CornerRadius="160"
                            Background="#22D24CFF"
                            Canvas.Left="36"
                            Canvas.Top="-70">
                        <Border.Effect>
                            <BlurEffect Radius="70" />
                        </Border.Effect>
                    </Border>
                    <Border Width="440"
                            Height="440"
                            CornerRadius="220"
                            Background="#1EDD68D4"
                            Canvas.Right="-120"
                            Canvas.Bottom="-110">
                        <Border.Effect>
                            <BlurEffect Radius="96" />
                        </Border.Effect>
                    </Border>
                    <Border Width="260"
                            Height="260"
                            CornerRadius="130"
                            Background="#155C8CFF"
                            Canvas.Right="280"
                            Canvas.Top="72">
                        <Border.Effect>
                            <BlurEffect Radius="58" />
                        </Border.Effect>
                    </Border>
                    <Border Width="540"
                            Height="540"
                            CornerRadius="270"
                            Background="#163BB8FF"
                            Canvas.Left="420"
                            Canvas.Top="180">
                        <Border.Effect>
                            <BlurEffect Radius="140" />
                        </Border.Effect>
                    </Border>
                    <Border Width="380"
                            Height="380"
                            CornerRadius="190"
                            Background="#14FF6EB7"
                            Canvas.Right="120"
                            Canvas.Top="250">
                        <Border.Effect>
                            <BlurEffect Radius="110" />
                        </Border.Effect>
                    </Border>
                    <Border Width="680"
                            Height="680"
                            CornerRadius="340"
                            Background="#0EFFFFFF"
                            Canvas.Left="520"
                            Canvas.Top="40">
                        <Border.Effect>
                            <BlurEffect Radius="180" />
                        </Border.Effect>
                    </Border>
                </Canvas>

                <ScrollViewer x:Name="StandardSectionScrollViewer"
                              Padding="108,24,28,88"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="StandardSectionHost" />
                </ScrollViewer>

                <Border x:Name="ViewportSectionHostContainer"
                        Margin="108,24,28,24"
                        IsVisible="False">
                    <ContentControl x:Name="ViewportSectionHost"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </Border>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,18,28,0"
                        Padding="16,12"
                        CornerRadius="18"
                        Background="{Binding ToastBackground}"
                        IsVisible="{Binding IsToastVisible}"
                        ZIndex="20">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity"
                                              Duration="0:0:0.18" />
                        </Transitions>
                    </Border.Transitions>

                    <TextBlock MaxWidth="280"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{Binding ToastForeground}"
                               Text="{Binding ToastMessage}"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource StatusBarBackgroundBrush}"
                    BorderBrush="{DynamicResource ChromeBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="108,10,28,10">
                    <StackPanel HorizontalAlignment="Center"
                                Spacing="7"
                                Width="420"
                                IsVisible="{Binding IsTaskMonitorVisible}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding TaskTitle}"
                                   TextAlignment="Center" />

                        <Grid Width="420"
                              Height="16">
                            <Border Height="16"
                                    CornerRadius="99"
                                    Background="#24172331" />
                            <Border Width="{Binding TaskProgressFillWidth}"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    CornerRadius="99"
                                    ClipToBounds="True">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Width"
                                                          Duration="0:0:0.14" />
                                    </Transitions>
                                </Border.Transitions>

                                <Grid ClipToBounds="True">
                                    <Border Background="{DynamicResource AccentStrongBrush}" />
                                    <Canvas IsHitTestVisible="False">
                                        <Canvas.RenderTransform>
                                            <TranslateTransform X="{Binding TaskStripeOffset}" />
                                        </Canvas.RenderTransform>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="-32"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="0"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="32"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="64"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="96"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="128"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="160"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="192"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="224"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="256"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="288"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="320"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="352"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="384"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="416"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border Width="16"
                                                Height="34"
                                                Background="#44FFF5FF"
                                                CornerRadius="8"
                                                Canvas.Left="448"
                                                Canvas.Top="-9">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-24" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Canvas>
                                </Grid>
                            </Border>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding TaskProgressLabel}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Spacing="4">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <TextBlock FontSize="13"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding AppTitle}" />
                            <TextBlock FontSize="13"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding AppVersionLabel}" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="13"
                                   FontWeight="Light"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding AppAuthorLabel}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</Window>
