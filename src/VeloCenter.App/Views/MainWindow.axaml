<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VeloCenter.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="VeloCenter.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1200"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        Background="#F3F4EE"
        Title="velo-center">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="24">
        <Border Padding="28"
                CornerRadius="28"
                Background="#14281F">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding AppTitle}"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="#F5F8F1" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="16"
                               Foreground="#C8D4CB" />
                    <Border Padding="12,8"
                            CornerRadius="14"
                            Background="#243A2F"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding CurrentFocus}"
                                   FontSize="13"
                                   Foreground="#DDF275" />
                    </Border>
                </StackPanel>

                <Border Padding="18,12"
                        CornerRadius="18"
                        Background="#DDF275"
                        VerticalAlignment="Top">
                    <TextBlock Text="Avalonia starter"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#14281F" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,24,0,0"
              ColumnDefinitions="2*,1*"
              ColumnSpacing="24">
            <StackPanel Spacing="24">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
                    <Border Padding="18"
                            CornerRadius="22"
                            Background="#FFFFFF">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Activities"
                                       FontSize="14"
                                       Foreground="#5B6C61" />
                            <TextBlock Text="{Binding Overview.TotalActivities}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#14281F" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="18"
                            CornerRadius="22"
                            Background="#FFFFFF">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Distance"
                                       FontSize="14"
                                       Foreground="#5B6C61" />
                            <TextBlock Text="{Binding Overview.TotalDistanceLabel}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#14281F" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="18"
                            CornerRadius="22"
                            Background="#FFFFFF">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Time"
                                       FontSize="14"
                                       Foreground="#5B6C61" />
                            <TextBlock Text="{Binding Overview.TotalDurationLabel}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#14281F" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Padding="22"
                        CornerRadius="24"
                        Background="#FFFFFF">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Recent rides"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#14281F" />

                        <ItemsControl ItemsSource="{Binding RecentActivities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentRideViewModel">
                                    <Border Margin="0,0,0,12"
                                            Padding="16"
                                            CornerRadius="18"
                                            Background="#F7F8F3">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="#14281F" />
                                                <TextBlock Text="{Binding StartDateLabel}"
                                                           FontSize="13"
                                                           Foreground="#5B6C61" />
                                            </StackPanel>

                                            <StackPanel Spacing="4"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding DistanceLabel}"
                                                           HorizontalAlignment="Right"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="#14281F" />
                                                <TextBlock Text="{Binding DurationLabel}"
                                                           HorizontalAlignment="Right"
                                                           FontSize="13"
                                                           Foreground="#5B6C61" />
                                                <TextBlock Text="{Binding SourceLabel}"
                                                           HorizontalAlignment="Right"
                                                           FontSize="13"
                                                           Foreground="#7B8C3B" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="22"
                    CornerRadius="24"
                    Background="#FFFFFF">
                <StackPanel Spacing="18">
                    <TextBlock Text="Next steps"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#14281F" />

                    <ItemsControl ItemsSource="{Binding NextSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12"
                                        Padding="14"
                                        CornerRadius="16"
                                        Background="#F7F8F3">
                                    <TextBlock Text="{Binding .}"
                                               TextWrapping="Wrap"
                                               Foreground="#31453A" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</Window>
