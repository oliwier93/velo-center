<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VeloCenter.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="VeloCenter.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        d:DesignWidth="1380"
        d:DesignHeight="860"
        Width="1380"
        Height="860"
        MinWidth="1040"
        MinHeight="680"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="/Assets/avalonia-logo.ico"
        Title="Velo Center">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.nav-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="#241A2036" />
            <Setter Property="Foreground" Value="{DynamicResource AccentRoseBrush}" />
        </Style>

        <Style Selector="Button.nav-item.selected">
            <Setter Property="Background" Value="#2A23153A" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.toolbar-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style Selector="Button.toolbar-button:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </Window.Styles>

    <Grid ClipToBounds="False">
        <Border Width="{Binding SidebarWidth}"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource ChromeBorderBrush}"
                BorderThickness="0,0,1,0"
                ZIndex="10"
                PointerEntered="SidebarPointerEntered"
                PointerExited="SidebarPointerExited">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width"
                                      Duration="0:0:0.18" />
                </Transitions>
            </Border.Transitions>

            <Grid RowDefinitions="Auto,*">
                <Grid Margin="0,20,0,18">
                    <Grid Height="52"
                          ClipToBounds="True">
                        <Grid ColumnDefinitions="80,*">
                            <Border Width="52"
                                    Height="52"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="18"
                                    Background="#4FA669FF">
                                <Viewbox Width="30"
                                         Height="24"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Path Data="M5,17 A3.5,3.5 0 1 0 5.1,17 M19,17 A3.5,3.5 0 1 0 19.1,17 M8.5,17 L12.5,10 L16.5,17 M10.2,17 H14.7 M12.5,10 H17 M12.5,10 L10,6.5 H8"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource TextPrimaryBrush}"
                                          StrokeLineCap="Round"
                                          StrokeThickness="1.9" />
                                </Viewbox>
                            </Border>

                            <Border Grid.Column="1"
                                    ClipToBounds="True"
                                    IsVisible="{Binding IsSidebarContentExpanded}">
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding AppTitle}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <ItemsControl Grid.Row="1"
                              Margin="0,8,0,0"
                              ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItemViewModel">
                            <Button Classes="nav-item"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding ActivateCommand}"
                                    CommandParameter="{Binding .}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    ToolTip.Tip="{Binding Title}">
                                <Border Background="{Binding $parent[Button].Background}">
                                    <Grid Height="60"
                                          ColumnDefinitions="4,*">
                                        <Border Width="4"
                                                Height="32"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AccentRoseBrush}"
                                                CornerRadius="99"
                                                Opacity="{Binding SelectionOpacity}" />

                                        <Grid Grid.Column="1"
                                              Margin="14,0,18,0"
                                              VerticalAlignment="Center">
                                            <Grid ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="14"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding IsExpanded}">
                                                <Border Width="42"
                                                        Height="42"
                                                        CornerRadius="15"
                                                        Background="{Binding IconBackground}">
                                                        <Path Width="20"
                                                              Height="20"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Data="{Binding IconPathData}"
                                                              Stroke="{Binding $parent[Button].Foreground}"
                                                              StrokeLineCap="Round"
                                                              StrokeThickness="1.9" />
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding $parent[Button].Foreground}"
                                                           Text="{Binding Title}" />
                                            </Grid>

                                            <Border Width="42"
                                                    Height="42"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding IconBackground}"
                                                    CornerRadius="15"
                                                    IsVisible="{Binding IsCollapsed}">
                                                <Path Width="20"
                                                      Height="20"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="{Binding IconPathData}"
                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                      StrokeLineCap="Round"
                                                      StrokeThickness="1.9" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Grid RowDefinitions="Auto,*,Auto">
            <Border Background="{DynamicResource TopBarBackgroundBrush}"
                    BorderBrush="{DynamicResource ChromeBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="108,18,28,18"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding CurrentSectionTitle}" />
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding CurrentSectionDescription}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <Border Padding="14,10"
                                CornerRadius="16"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelStrokeBrush}"
                                BorderThickness="1">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding CurrentRangeLabel}" />
                        </Border>

                        <Border Padding="14,10"
                                CornerRadius="16"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelStrokeBrush}"
                                BorderThickness="1">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding DataModeLabel}" />
                        </Border>

                        <Button Classes="toolbar-button"
                                Command="{Binding RefreshCommand}">
                            <Border Padding="14,10"
                                    CornerRadius="16"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelStrokeBrush}"
                                    BorderThickness="1">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding $parent[Button].Foreground}"
                                           Text="Odswiez" />
                            </Border>
                        </Button>

                        <Button Classes="toolbar-button"
                                Command="{Binding SyncCommand}">
                            <Border Padding="14,10"
                                    CornerRadius="16"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelStrokeBrush}"
                                    BorderThickness="1">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding $parent[Button].Foreground}"
                                           Text="Synchronizuj" />
                            </Border>
                        </Button>

                        <Button Classes="toolbar-button"
                                Command="{Binding ImportCommand}">
                            <Border Padding="14,10"
                                    CornerRadius="16"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentStrongBrush}"
                                    BorderThickness="1">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="Importuj" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Canvas IsHitTestVisible="False">
                    <Border Width="320"
                            Height="320"
                            CornerRadius="160"
                            Background="#22D24CFF"
                            Canvas.Left="36"
                            Canvas.Top="-70" />
                    <Border Width="440"
                            Height="440"
                            CornerRadius="220"
                            Background="#1EDD68D4"
                            Canvas.Right="-120"
                            Canvas.Bottom="-110" />
                    <Border Width="260"
                            Height="260"
                            CornerRadius="130"
                            Background="#155C8CFF"
                            Canvas.Right="280"
                            Canvas.Top="72" />
                </Canvas>

                <ScrollViewer Padding="108,24,28,24"
                              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding CurrentSectionViewModel}" />
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource StatusBarBackgroundBrush}"
                    BorderBrush="{DynamicResource ChromeBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="108,14,28,14"
                      ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="18">
                    <Border Padding="12,8"
                            CornerRadius="14"
                            Background="{Binding StatusBadgeBackground}"
                            BorderBrush="{DynamicResource PanelStrokeBrush}"
                            BorderThickness="1">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding StatusBadgeForeground}"
                                   Text="{Binding StatusState}" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Spacing="4">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   Text="STATUS" />
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding ActiveTask}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right"
                                Spacing="4">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   Text="SESJA" />
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding LastActionLabel}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</Window>
