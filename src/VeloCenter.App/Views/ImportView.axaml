<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeloCenter.App.ViewModels"
             x:Class="VeloCenter.App.Views.ImportView"
             x:DataType="vm:ImportViewModel">
    <UserControl.Styles>
        <Style Selector="Button.integration-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="Button.integration-action:pointerover">
            <Setter Property="Opacity" Value="0.93" />
        </Style>

        <Style Selector="Button.integration-action:pressed">
            <Setter Property="Opacity" Value="0.88" />
        </Style>

        <Style Selector="Button.integration-action:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
    </UserControl.Styles>

    <Grid MaxWidth="940"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          ColumnDefinitions="*,*"
          ColumnSpacing="18">
        <Border Padding="20"
                CornerRadius="24"
                Background="{DynamicResource PanelStrongBackgroundBrush}"
                BorderBrush="{DynamicResource PanelStrokeBrush}"
                BorderThickness="1">
            <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Strava" />
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               Text="Tylko aktywnosci rowerowe outdoor." />
                </StackPanel>

                <TextBlock FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Wklej Client ID i Client Secret swojej aplikacji Strava. Po kliknieciu otworzy sie przegladarka z autoryzacja."
                           TextWrapping="Wrap" />

                <Grid ColumnDefinitions="1*,3*"
                      RowDefinitions="Auto"
                      ColumnSpacing="10"
                      RowSpacing="10"
                      IsVisible="{Binding ShowStravaCredentials}">
                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Spacing="4">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   Text="Client ID" />
                        <TextBox Text="{Binding StravaClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="np. 162592" />
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Spacing="4">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   Text="Client Secret" />
                        <TextBox Text="{Binding StravaClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Wklej client secret" />
                    </StackPanel>
                </Grid>

                <Border Padding="14"
                        CornerRadius="18"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelStrokeBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding StravaStatusTitle}"
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding StravaStatusDetail}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal"
                            Spacing="10">
                    <Button Classes="integration-action"
                            Click="SyncStravaClick"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding CanPrimaryStravaAction}">
                        <Border Padding="18,14"
                                CornerRadius="20"
                                Background="{DynamicResource AccentStrongBrush}">
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding StravaPrimaryActionLabel}" />
                        </Border>
                    </Button>

                    <Button Classes="integration-action"
                            Click="DisconnectStravaClick"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding ShowStravaDisconnectAction}"
                            IsEnabled="{Binding CanConnectStrava}">
                        <Border Padding="18,14"
                                CornerRadius="20"
                                Background="#182A1734"
                                BorderBrush="{DynamicResource PanelStrokeBrush}"
                                BorderThickness="1">
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Rozlacz" />
                        </Border>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Padding="20"
                CornerRadius="24"
                Background="{DynamicResource PanelStrongBackgroundBrush}"
                BorderBrush="{DynamicResource PanelStrokeBrush}"
                BorderThickness="1">
            <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Pliki lokalne" />
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               Text="{Binding AcceptedExtensionsLabel}" />
                </StackPanel>

                <TextBlock FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Importuj pojedyncze pliki treningowe do lokalnej bazy i od razu odswiezaj widoki aplikacji."
                           TextWrapping="Wrap" />

                <Button Classes="integration-action"
                        Click="PickFileClick"
                        HorizontalAlignment="Left">
                    <Border Padding="18,14"
                            CornerRadius="20"
                            Background="{DynamicResource AccentStrongBrush}">
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Wybierz plik" />
                    </Border>
                </Button>

                <TextBlock FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{Binding ImportStatus}"
                           IsVisible="{Binding HasImportStatus}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
