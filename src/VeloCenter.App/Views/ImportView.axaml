<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeloCenter.App.ViewModels"
             x:Class="VeloCenter.App.Views.ImportView"
             x:DataType="vm:ImportViewModel">
    <Grid ColumnDefinitions="*,*"
          ColumnSpacing="24">
        <Border Padding="22"
                CornerRadius="24"
                Background="{DynamicResource PanelStrongBackgroundBrush}"
                BorderBrush="{DynamicResource PanelStrokeBrush}"
                BorderThickness="1">
            <StackPanel Spacing="16">
                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="Zrodla danych" />

                <ItemsControl ItemsSource="{Binding Sources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:InfoCardViewModel">
                            <Border Margin="0,0,0,12"
                                    Padding="16"
                                    CornerRadius="18"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelStrokeBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextSubtleBrush}"
                                               Text="{Binding Title}" />
                                    <TextBlock FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Value}" />
                                    <TextBlock FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Padding="22"
                CornerRadius="24"
                Background="{DynamicResource PanelStrongBackgroundBrush}"
                BorderBrush="{DynamicResource PanelStrokeBrush}"
                BorderThickness="1">
            <StackPanel Spacing="16">
                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="Kolejka przeplywu" />

                <ItemsControl ItemsSource="{Binding Pipeline}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:InfoCardViewModel">
                            <Border Margin="0,0,0,12"
                                    Padding="16"
                                    CornerRadius="18"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelStrokeBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextSubtleBrush}"
                                               Text="{Binding Title}" />
                                    <TextBlock FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Value}" />
                                    <TextBlock FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
