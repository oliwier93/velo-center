<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeloCenter.App.ViewModels"
             x:Class="VeloCenter.App.Views.ImportView"
             x:DataType="vm:ImportViewModel">
    <UserControl.Styles>
        <Style Selector="Button.import-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="Button.import-action:pointerover">
            <Setter Property="Opacity" Value="0.93" />
        </Style>

        <Style Selector="Button.import-action:pressed">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
    </UserControl.Styles>

    <Border Padding="20,18"
            CornerRadius="24"
            Background="{DynamicResource PanelStrongBackgroundBrush}"
            BorderBrush="{DynamicResource PanelStrokeBrush}"
            BorderThickness="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
        <Grid MaxWidth="560"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="24"
              RowSpacing="10">
            <StackPanel Spacing="6">
                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="Import pliku" />

                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextSubtleBrush}"
                           Text="{Binding AcceptedExtensionsLabel}" />
            </StackPanel>

            <Button Classes="import-action"
                    Grid.Column="1"
                    Grid.RowSpan="2"
                    Click="PickFileClick"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <Border Padding="18,14"
                        CornerRadius="20"
                        Background="{DynamicResource AccentStrongBrush}">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Wybierz plik" />
                </Border>
            </Button>

            <TextBlock Grid.Row="1"
                       FontSize="13"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="{Binding ImportStatus}"
                       IsVisible="{Binding HasImportStatus}"
                       TextWrapping="Wrap" />
        </Grid>
    </Border>
</UserControl>
